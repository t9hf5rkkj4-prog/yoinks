{
  "name": "yoinks",
  "productName": "yoinks",
  "version": "1.0.0",
  "description": "yoink any video. paste. yoink. done.",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "…whatever step 1 wrote…",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "com.yourname.yoinks",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/app-icon.png"
    }
  }
}